# ══════════════════════════════════════════════════════════════════════════════
# Tadiosa Customer Website — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the values before running the dev server.
# Only NON-SECRET, public values belong here — Vite bundles every VITE_* var
# into the static output, so they are publicly visible in the browser.
# ══════════════════════════════════════════════════════════════════════════════


# ── SmartRent public catalog API ───────────────────────────────────────────────
# Base URL (no trailing slash) of the SmartRent backend's PUBLIC catalog API.
# The site reads the live item list from here (GET <VITE_API_URL>/public/items).
#
# Development (SmartRent API runs on 5000):
VITE_API_URL=http://localhost:5000/api/v1
#
# Production example:
# VITE_API_URL=https://smartrent-api.up.railway.app/api/v1


# ── AR Virtual Try-On app ──────────────────────────────────────────────────────
# Base URL (no trailing slash) of the deployed AR Try-On app (smartrent-ar).
# The "Try On AR" button opens this app for a single item overlay.
# Defaults to the AR app's pinned dev port (5175) when unset.
#
# Development:
VITE_AR_APP_URL=http://localhost:5175
#
# Production example:
# VITE_AR_APP_URL=https://smartrent-ar.vercel.app
